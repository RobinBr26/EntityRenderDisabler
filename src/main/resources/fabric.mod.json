{
  "schemaVersion": 1,
  "id": "entityrenderdisablerrewritefabric",
  "version": "${version}",
  "name": "EntityRenderDisabler",
  "description": "Suppress selected client entities, their rendering, ticks, sounds and effects",
  "authors": [
    "Ponchisao326"
  ],
  "contributors": ["Optimized by RobinBr26"],
  "contact": {
    "homepage": "https://modrinth.com/project/entity-render-disabler",
    "sources": "https://github.com/ponchisao326/EntityRenderDisabler",
    "issues": "https://github.com/ponchisao326/EntityRenderDisabler/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/entityrenderdisablerrewritefabric/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "com.victorgponce.entityrenderdisablerrewritefabric.client.EntityrenderdisablerrewritefabricDataGenerator"
    ],
    "client": [
      "com.victorgponce.entityrenderdisablerrewritefabric.client.EntityrenderdisablerrewritefabricClient"
    ],
    "main": [
      "com.victorgponce.entityrenderdisablerrewritefabric.Entityrenderdisablerrewritefabric"
    ],
    "modmenu": [
      "com.victorgponce.entityrenderdisablerrewritefabric.client.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "entityrenderdisablerrewritefabric.mixins.json",
    {
      "config": "entityrenderdisablerrewritefabric.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "yet_another_config_lib_v3": ">=${yacl_version}"
  },
  "suggests": {
    "modmenu": "${modmenu_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.website": "https://victorgponce.com"
      },
      "description": "A minecraft mod to disable Entity Render",
      "icon": "assets/entityrenderdisablerrewritefabric/icon.png",
      "update_checker": false
    }
  }
}
